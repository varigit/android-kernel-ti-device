# Label `:target_build_config` can be set during build to override the ti.generated
# build config and append additional sources, like a device-specific
# build.config.<device> file.
label_flag(
    name = "target_build_config",
    build_setting_default = ":build.config.ti.generated",
    visibility = [
        "//private/devices/ti:__subpackages__",
    ],
)

kernel_build_config(
    name = "build.config.ti.generated",
    srcs = [
        # do not sort
        "//ti-linux-kernel:set_kernel_dir_build_config",
        "build.config.ti",
        "//ti-linux-kernel:build.config.constants",
    ],
    visibility = [
        "//private/devices/ti:__subpackages__",
    ],
)

kernel_build(
    name = "ti",
    srcs = [
        "//ti-linux-kernel:kernel_aarch64_sources",
    ],
    outs = TI_DTBS + TI_DTBOS,
    base_kernel = "//common:kernel_aarch64_download_or_build",
    build_config = ":target_build_config",
    collect_unstripped_modules = True,
    defconfig = "//common:arch/arm64/configs/gki_defconfig",
    kmi_symbol_list = "//common:gki/aarch64/symbols/ti",
    make_goals = [
        "modules",
